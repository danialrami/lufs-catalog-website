---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const releases = await getCollection('releases');
  
  return releases.map((release) => ({
    params: { slug: release.slug },
    props: { release },
  }));
}

const { release } = Astro.props;
---

<BaseLayout title="{release.data.title} — LUFS Catalog">
  <header>
      <div class="container">
        <a href="/" class="back-link">← Back to Catalog</a>
        
        <h1>{release.data.title}</h1>
        
        <div class="release-meta">
          <span class="badge-project">{release.data.project}</span>
          
          {release.data.artist && (
            <span class="artist">{release.data.artist}</span>
          )}
          
          {release.data.isrc && (
            <span class="badge-catalog">ISRC: {release.data.isrc}</span>
          )}
          
          <span class="release-date">
            Released: {new Date(release.data.releaseDate).toLocaleDateString()}
          </span>
        </div>
      </div>
    </header>

    <main class="container">
      {release.data.coverArt && (
        <img 
          src={release.data.coverArt} 
          alt={`${release.data.title} cover art`}
          class="cover-art"
        />
      )}

      <section class="track-list">
        <h2>Tracks</h2>
        
        {release.data.tracks.length > 0 ? (
          <div class="tracks">
            {release.data.tracks.map((track) => (
              <div class="track-row">
                <div class="track-info">
                  <span class="track-number">{track.trackNumber}</span>
                  <button 
                    class="track-play-btn play-button"
                    data-audio-path={track.audioPath}
                    data-track-title={track.displayTitle}
                    aria-label={`Play ${track.displayTitle}`}
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" fill="#78BEBA"/>
                    </svg>
                  </button>
                  <div class="track-details">
                    <span class="track-title">{track.displayTitle}</span>
                    <span class="track-meta">
                      {track.catalogNumber && <span class="catalog-number">{track.catalogNumber}</span>}
                      {track.saturation && <span class="saturation">Sat: {track.saturation}</span>}
                    </span>
                  </div>
                </div>
                
                <div class="track-actions">
                  {track.finalReport && (
                    <a href={track.finalReport} target="_blank" class="report-link">
                      View Report
                    </a>
                  )}
                  {track.renderStatsPath && (
                    <a href={track.renderStatsPath} target="_blank" class="report-link">
                      Render Stats
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p>No tracks available yet.</p>
        )}
      </section>

      {release.data.streamingLinks && (
        <section class="streaming-links">
          <h2>Stream On</h2>
          <div class="links">
            {release.data.streamingLinks.spotify && (
              <a href={release.data.streamingLinks.spotify} target="_blank" class="stream-link spotify">
                Spotify
              </a>
            )}
            {release.data.streamingLinks.appleMusic && (
              <a href={release.data.streamingLinks.appleMusic} target="_blank" class="stream-link apple">
                Apple Music
              </a>
            )}
            {release.data.streamingLinks.bandcamp && (
              <a href={release.data.streamingLinks.bandcamp} target="_blank" class="stream-link bandcamp">
                Bandcamp
              </a>
            )}
            {release.data.streamingLinks.soundcloud && (
              <a href={release.data.streamingLinks.soundcloud} target="_blank" class="stream-link soundcloud">
                SoundCloud
              </a>
            )}
          </div>
        </section>
      )}
    </main>

    <script>
      // Track play buttons - dispatch to player store
      document.querySelectorAll('.track-play-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const audioPath = (btn as HTMLElement).dataset.audioPath;
          const trackTitle = (btn as HTMLElement).dataset.trackTitle;
          
          console.log('Play clicked:', audioPath, trackTitle);
          
          // Dispatch custom event for player
          window.dispatchEvent(new CustomEvent('play-track', {
            detail: { audioPath, trackTitle }
          }));
        });
      });
    </script>

    <style>
      :root {
        --color-bg: #111111;
        --color-surface: #1a1a1a;
        --color-surface-2: #242424;
        --color-text: #fbf9e2;
        --color-text-muted: #E2E3D8;
        --color-teal: #78BEBA;
        --color-red: #D35233;
        --color-yellow: #E7B225;
        --color-blue: #2069AF;
        --color-border: rgba(251, 249, 226, 0.08);
        --player-height: 72px;
        --font-mono: "SF Mono", "JetBrains Mono", ui-monospace, monospace;
      }
      
      * { box-sizing: border-box; }
      
      body {
        margin: 0;
        padding: 0;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: system-ui, -apple-system, sans-serif;
      }
      
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1.5rem;
        padding-bottom: calc(var(--player-height) + 2rem);
      }
      
      header {
        padding: 2rem 0 1rem;
      }
      
      .back-link {
        color: var(--color-teal);
        text-decoration: none;
        font-size: 0.875rem;
      }
      
      .back-link:hover {
        text-decoration: underline;
      }
      
      h1 {
        margin: 1rem 0 0.5rem 0;
        font-size: 2.5rem;
        color: var(--color-text);
      }
      
      h2 {
        margin: 2rem 0 1rem 0;
        font-size: 1.25rem;
        color: var(--color-text);
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 0.5rem;
      }
      
      .release-meta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 1rem;
      }
      
      .badge-project {
        background-color: var(--color-blue);
        color: #fff;
        padding: 0.25rem 0.75rem;
        border-radius: 2px;
        font-size: 0.75rem;
      }
      
      .badge-catalog {
        background-color: var(--color-yellow);
        color: #111;
        padding: 0.25rem 0.75rem;
        border-radius: 2px;
        font-size: 0.75rem;
        font-family: var(--font-mono);
      }
      
      .artist {
        color: var(--color-text-muted);
      }
      
      .release-date {
        color: var(--color-text-muted);
        font-size: 0.875rem;
      }
      
      .cover-art {
        width: 100%;
        max-width: 400px;
        height: auto;
        border-radius: 4px;
        margin-top: 1.5rem;
      }
      
      .track-list {
        margin-top: 2rem;
      }
      
      .tracks {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      
      .track-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background-color: var(--color-surface);
        border-radius: 4px;
        gap: 1rem;
      }
      
      .track-info {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
      }
      
      .track-number {
        color: var(--color-text-muted);
        font-family: var(--font-mono);
        width: 1.5rem;
      }
      
      .track-play-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: var(--color-surface-2);
        transition: background-color 0.2s;
      }
      
      .track-play-btn:hover {
        background-color: var(--color-teal);
      }
      
      .track-play-btn:hover svg path {
        fill: #111;
      }
      
      .track-details {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      
      .track-title {
        font-weight: 600;
      }
      
      .track-meta {
        display: flex;
        gap: 0.75rem;
        font-size: 0.75rem;
        color: var(--color-text-muted);
        font-family: var(--font-mono);
      }
      
      .track-actions {
        display: flex;
        gap: 0.5rem;
      }
      
      .report-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        background-color: var(--color-surface-2);
        color: var(--color-teal);
        border-radius: 2px;
        text-decoration: none;
      }
      
      .report-link:hover {
        background-color: var(--color-teal);
        color: #111;
      }
      
      .streaming-links {
        margin-top: 2rem;
      }
      
      .links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      
      .stream-link {
        padding: 0.5rem 1rem;
        border-radius: 4px;
        text-decoration: none;
        font-weight: 600;
      }
      
      .stream-link.spotify {
        background-color: #1DB954;
        color: #000;
      }
      
      .stream-link.apple {
        background-color: #FA243C;
        color: #fff;
      }
      
      .stream-link.bandcamp {
        background-color: #629AA9;
        color: #fff;
      }
      
      .stream-link.soundcloud {
        background-color: #FF5500;
        color: #fff;
      }
      
      footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
      }
    </style>
  </BaseLayout>
