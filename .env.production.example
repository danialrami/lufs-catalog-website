# ───────────────────────────────────────────────────────────────────────
# Production environment for catalog.lufs.audio  (.env.production)
# ───────────────────────────────────────────────────────────────────────
# Copy to .env.production and fill in. NEVER commit the filled-in file.
# Only PUBLIC_* vars are exposed to the browser bundle; everything else is
# server/script/Worker-only (R2 + rustfs credentials must stay secret).
#
# The catalog-operator opencode agent reads these to drive ingest/deploy and
# to switch the active storage origin. See docs/implementation/.
# ───────────────────────────────────────────────────────────────────────

# ─── Storage switch (the R2 <-> rustfs control) ────────────────────────
STORAGE_MODE=remote              # local | remote  (local = serve from public/, no cloud)
STORAGE_PRIMARY=r2               # r2 | rustfs     (which origin the site serves from)
STORAGE_MIRROR=none              # none | r2 | rustfs  (also upload a 2nd copy on ingest)
STREAM_FALLBACK_ENABLED=false    # true | false    (auto fail over to the other origin)

# ─── Site ──────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://catalog.lufs.audio

# ─── Cloudflare R2 (primary) ───────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lufs-catalog
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com   # replace ACCOUNT_ID
# PUBLIC_R2_BASE_URL=   # OPTIONAL/UNUSED: reports+covers are committed to public/, not served from R2.
# Only set this (no angle brackets) if you later serve public assets from an R2 public bucket / cdn.lufs.audio.
PUBLIC_R2_STREAM_URL=https://stream.lufs.audio      # R2 signing Worker (private audio)

# ─── NAS rustfs (fallback / alternative origin) ────────────────────────
# Leave commented until the rustfs endpoint + reverse proxy + TLS are stood up.
# To make the NAS primary:  ./scripts/catalog-set-origin.sh rustfs
# RUSTFS_ACCESS_KEY_ID=
# RUSTFS_SECRET_ACCESS_KEY=
# RUSTFS_BUCKET_NAME=lufs-catalog
# RUSTFS_ENDPOINT=https://s3.lufs.audio
# PUBLIC_RUSTFS_BASE_URL=https://s3.lufs.audio          # public reports/artwork mirror
# PUBLIC_RUSTFS_STREAM_URL=https://stream-nas.lufs.audio # optional 2nd signer for private audio

# ─── Ingest ──────────────────────────────────────────────────────────────
CATALOG_SOURCE_PATH=/Volumes/project/continuo/catalogs
CATALOG_ORGANIZE=project          # project | year | flat  (presentation grouping only)

# ─── GitHub / Hostinger deploy ─────────────────────────────────────────
GITHUB_REPO=https://github.com/danialrami/lufs-catalog-website.git
HOSTINGER_BRANCH=hostinger

# ─── Feature flags ─────────────────────────────────────────────────────
SHOW_DRAFTS=false
