# ───────────────────────────────────────────────────────────────────────
# Local-Only Development (.env.local)
# ───────────────────────────────────────────────────────────────────────
# Copy to .env.local. For production (Cloudflare R2 + the rustfs switch),
# see .env.production.example.
# ───────────────────────────────────────────────────────────────────────

# Absolute path to the local workchain catalogs (albums) directory
CATALOG_SOURCE_PATH=/Volumes/project/continuo/catalogs

# Site URL for local dev
PUBLIC_SITE_URL=http://localhost:4321

# Show draft/unreleased releases in the UI locally
SHOW_DRAFTS=true

# Storage: 'local' serves audio straight from public/ (no cloud, no Worker).
# Set to 'remote' only with the R2 vars from .env.production.example.
STORAGE_MODE=local

# MP3 transcode bitrate for ingest (default 320k)
MP3_BITRATE=320k
